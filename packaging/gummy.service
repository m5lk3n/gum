[Unit]
Description=gummy (go-util-mcp) MCP server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=gummy
Group=gummy
EnvironmentFile=-/etc/default/gummy
ExecStart=/usr/bin/gummy
Restart=on-failure
RestartSec=5s
# gummy waits for a running apt job (up to GUMMY_JOB_TIMEOUT) before exiting; never kill dpkg early.
TimeoutStopSec=65min
KillMode=mixed

# Hardening is deliberately limited: gummy escalates through sudo (so NoNewPrivileges is off),
# and apt-get inherits this unit's sandbox, so it must be able to write /usr, /etc, /var, /boot.
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
