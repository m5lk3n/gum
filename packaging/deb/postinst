#!/bin/sh
# gum postinst: create the gum user, install the sudoers rule, enable gum.service.
#
# gum.service is started on a fresh install but deliberately NOT restarted on
# upgrade: when gum upgrades itself (apt_upgrade), this script runs inside
# gum.service, and restarting it from here would wait on itself until the stop
# timeout and then kill dpkg. The old gum keeps running until restarted.
set -e

USER_NAME=gum
SUDOERS=/etc/sudoers.d/gum
UNIT=gum.service

install_sudoers() {
    tmp="$(mktemp)"
    gum --print-sudoers "$USER_NAME" >"$tmp"
    if ! visudo -cf "$tmp" >/dev/null; then
        rm -f "$tmp"
        echo "gum: generated sudoers rule failed validation; not installed" >&2
        exit 1
    fi
    install -m 0440 -o root -g root "$tmp" "$SUDOERS"
    rm -f "$tmp"
}

case "$1" in
    configure)
        if ! getent passwd "$USER_NAME" >/dev/null; then
            adduser --system --group --no-create-home --home /nonexistent \
                --quiet "$USER_NAME"
        fi
        # Regenerated on every configure, so it always matches the installed binary.
        install_sudoers
        ;;
esac

if [ "$1" = configure ] || [ "$1" = abort-upgrade ] ||
    [ "$1" = abort-deconfigure ] || [ "$1" = abort-remove ]; then
    # Only removes a mask created by deb-systemd-helper on package removal.
    deb-systemd-helper unmask "$UNIT" >/dev/null || true
    # was-enabled is true on a fresh install; afterwards it keeps the admin's choice.
    if deb-systemd-helper --quiet was-enabled "$UNIT"; then
        deb-systemd-helper enable "$UNIT" >/dev/null || true
    else
        deb-systemd-helper update-state "$UNIT" >/dev/null || true
    fi

    if [ -d /run/systemd/system ]; then
        systemctl --system daemon-reload >/dev/null || true
        # Start only if not running; a running gum (e.g., the one upgrading
        # itself) is left alone. "$2" alone can't tell: it's also set when
        # reinstalling after 'apt remove'.
        if systemctl --quiet is-active "$UNIT"; then
            if [ "$1" = configure ] && [ -n "$2" ]; then
                echo "gum: upgraded; run 'sudo systemctl restart gum' to activate the new version"
            fi
        else
            deb-systemd-invoke start "$UNIT" >/dev/null || true
        fi
    fi
fi

exit 0
